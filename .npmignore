# The package.json "files" allowlist already restricts the payload to the skill
# bundle; this file removes build/OS junk that can appear *inside* those dirs.

# Calibration/dev material — owner-specific rounds + eval briefs, not part of the shipped skill payload
skills/writer-style/testbed/
skills/writer-style/profiles/kaue/calibration/

# Evolution engine — maintainer-only self-improvement harness, not part of the shipped skill payload
skills/writer-style/evolution/

# Python bytecode / caches — never ship compiled artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
